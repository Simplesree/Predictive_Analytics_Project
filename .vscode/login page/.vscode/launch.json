import { useState } from "react";
import "./App.css";

function App() {
  const [showAbout, setShowAbout] = useState(false);
  const [showGuidelines, setShowGuidelines] = useState(false);

  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [role, setRole] = useState("");

  const handleSubmit = (e) => {
    e.preventDefault();

    if (!email || !password || !role) {
      alert("Please fill all the fields.");
      return;
    }

    alert(`Login submitted as ${role}`);
  };

  return (
    <div className="page">

      {/* ================= NAVBAR ================= */}
      <nav className="navbar">

        {/* Logo / Brand */}
        <div className="brand">
          <div className="brand-symbol">SI</div>
          <div>
            <h3>SOCIETAL</h3>
            <span>INNOVATION</span>
          </div>
        </div>

        {/* Navigation */}
        <div className="nav-links">

          {/* ABOUT */}
          <div className="nav-dropdown">
            <button
              className="nav-button"
              onClick={() => {
                setShowAbout(!showAbout);
                setShowGuidelines(false);
              }}
            >
              ABOUT SIH
              <span>▼</span>
            </button>

            {showAbout && (
              <div className="dropdown-menu">
                <a href="#about">About SIH</a>
                <a href="#vision">Our Vision</a>
                <a href="#mission">Our Mission</a>
              </div>
            )}
          </div>

          {/* GUIDELINES */}
          <div className="nav-dropdown">
            <button
              className="nav-button"
              onClick={() => {
                setShowGuidelines(!showGuidelines);
                setShowAbout(false);
              }}
            >
              GUIDELINES
              <span>▼</span>
            </button>

            {showGuidelines && (
              <div className="dropdown-menu">
                <a href="#eligibility">Eligibility</a>
                <a href="#rules">Rules</a>
                <a href="#process">Process</a>
              </div>
            )}
          </div>

          <a href="#problems">PROBLEM STATEMENTS</a>

          <a href="#spoc">KNOW YOUR SPOC</a>

          <a href="#implementation">
            PROJECT IMPLEMENTATION
          </a>

          <a href="#faqs">FAQS</a>

          <a href="#contact">CONTACT US</a>

        </div>

        {/* Mobile menu icon */}
        <button className="mobile-menu">
          ☰
        </button>

      </nav>


      {/* ================= HERO ================= */}
      <main className="hero">

        {/* Background decoration */}
        <div className="circle circle-one"></div>
        <div className="circle circle-two"></div>

        {/* Government Logo */}
        <div className="government-section">

          <div className="logo-wrapper">

            <img
              src="/jharkhand-logo.png"
              alt="Government of Jharkhand"
              className="jharkhand-logo"
              onError={(e) => {
                e.target.style.display = "none";
                document.querySelector(
                  ".logo-fallback"
                ).style.display = "flex";
              }}
            />

            <div className="logo-fallback">
              JH
            </div>

          </div>

          <div className="government-text">
            <p>GOVERNMENT OF</p>
            <h2>JHARKHAND</h2>
          </div>

        </div>


        {/* Main Heading */}
        <div className="heading-section">

          <p className="small-heading">
            SMART JAN SAMADHAN
          </p>

          <h1>
            SOCIETAL
            <br />
            <span>INNOVATION</span>
          </h1>

          <p className="subtitle">
            AI-Powered Platform for Citizen-Centric
            Problem Solving
          </p>

        </div>


        {/* ================= LOGIN CARD ================= */}
        <div className="login-box">

          <div className="login-header">

            <h2>Welcome Back</h2>

            <p>
              Login to access the Societal Innovation
              Platform
            </p>

          </div>


          <form onSubmit={handleSubmit}>

            {/* Email */}
            <div className="input-group">

              <label>Email Address</label>

              <div className="input-wrapper">

                <span className="input-icon">
                  ✉
                </span>

                <input
                  type="email"
                  placeholder="Enter your email"
                  value={email}
                  onChange={(e) =>
                    setEmail(e.target.value)
                  }
                />

              </div>

            </div>


            {/* Password */}
            <div className="input-group">

              <label>Password</label>

              <div className="input-wrapper">

                <span className="input-icon">
                  🔒
                </span>

                <input
                  type="password"
                  placeholder="Enter your password"
                  value={password}
                  onChange={(e) =>
                    setPassword(e.target.value)
                  }
                />

              </div>

            </div>


            {/* Role */}
            <div className="input-group">

              <label>User Role</label>

              <div className="input-wrapper">

                <span className="input-icon">
                  👤
                </span>

                <select
                  value={role}
                  onChange={(e) =>
                    setRole(e.target.value)
                  }
                >

                  <option value="">
                    Please Select User Role
                  </option>

                  <option value="Citizen">
                    Citizen
                  </option>

                  <option value="Administrator">
                    Administrator
                  </option>

                  <option value="SPOC">
                    SPOC
                  </option>

                  <option value="Government Department">
                    Government Department
                  </option>

                  <option value="University">
                    University / Institution
                  </option>

                  <option value="Industry">
                    Industry Partner
                  </option>

                </select>

              </div>

            </div>


            {/* Remember / Forgot */}
            <div className="login-options">

              <label className="remember">

                <input type="checkbox" />

                <span>
                  Remember me
                </span>

              </label>

              <a href="#forgot">
                Forgot Password?
              </a>

            </div>


            {/* Submit */}
            <button
              type="submit"
              className="submit-button"
            >
              LOGIN
              <span>→</span>
            </button>

          </form>


          {/* Register */}
          <div className="register-section">

            <p>
              Don't Have an Account?
            </p>

            <a href="#register">
              Register Now
            </a>

          </div>

        </div>


        {/* Bottom text */}
        <div className="bottom-text">

          <span>
            ✦
          </span>

          Empowering Citizens
          <span>•</span>
          Enabling Innovation
          <span>•</span>
          Building Solutions

          <span>
            ✦
          </span>

        </div>

      </main>


      {/* ================= FOOTER ================= */}
      <footer>

        <p>
          © 2026 Societal Innovation Platform |
          Government of Jharkhand
        </p>

      </footer>

    </div>
  );
}

export default App;